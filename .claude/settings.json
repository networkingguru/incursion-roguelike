{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "tools/held_queue.sh",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "command": "tools/instructions_loaded.sh",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "tools/resume_gc.sh --hook-end",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "tools/resume_gc.sh --hook-prompt",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "tools/dispatch_gate.py",
            "type": "command"
          }
        ],
        "matcher": "Agent|Task"
      },
      {
        "hooks": [
          {
            "command": "tools/close_gate.py",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ]
  }
}
