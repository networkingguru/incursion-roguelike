{
  "env": {
    "CLAUDE_CODE_SHELL_PREFIX": "/Users/brianhill/Scripts/Incursion/tools/kill_guard_prefix.sh"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "tools/held_queue.sh",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "command": "tools/instructions_loaded.sh",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "tools/resume_gc.sh --hook-end",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "tools/resume_gc.sh --hook-prompt",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "tools/dispatch_gate.py",
            "type": "command"
          }
        ],
        "matcher": "Agent|Task"
      },
      {
        "hooks": [
          {
            "command": "tools/close_gate.py",
            "type": "command"
          },
          {
            "command": "tools/kill_guard.py",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(*approve_order_break*)",
      "Bash(*order-approvals*)",
      "Bash(*order_approval_path*)",
      "Edit(~/.config/incursion/**)"
    ]
  }
}
