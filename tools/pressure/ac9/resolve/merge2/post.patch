+/* Resources the god Maeve declared in lib/main.irc, moved here
+ under the no-shared-tail layout (lib/landed.irc). Text unchanged. */
+
+/* Maeve's illusion dragon age templates (bead inc-pu6v.9 phase 7e, spec
+   docs/specs/2026-10-17-maeve-phase7-summons.md section 4, amendment
+   2026-10-21, dragons). Each is "exact monster" with the part naming the age
+   template explicitly, so the encounter's age step (src/Encounter.cpp:2275)
+   finds an age already chosen and adds none -- the illusion dragon never
+   exceeds the drawn CR. Data only; appended after the last Encounter in
+   lib/program.i order (Kysul's Illusion Stock, above) so no existing rID
+   shifts. */
+Encounter "exact hatchling dragon"
+  {
+    CR: 1+;
+    Parts:
+      * 1 of any MA_ALL $"hatchling" [EP_NOXCR];
+    Flags: NF_NOGEN, NF_SINGLE, NF_CONTEXT_AQUATIC;
+  }
+
+Encounter "exact very young dragon"
+  {
+    CR: 1+;
+    Parts:
+      * 1 of any MA_ALL $"very young" [EP_NOXCR];
+    Flags: NF_NOGEN, NF_SINGLE, NF_CONTEXT_AQUATIC;
+  }
+
+Encounter "exact young dragon"
+  {
+    CR: 1+;
+    Parts:
+      * 1 of any MA_ALL $"young" [EP_NOXCR];
+    Flags: NF_NOGEN, NF_SINGLE, NF_CONTEXT_AQUATIC;
+  }
+
+Encounter "exact juvenile dragon"
+  {
+    CR: 1+;
+    Parts:
+      * 1 of any MA_ALL $"juvenile" [EP_NOXCR];
+    Flags: NF_NOGEN, NF_SINGLE, NF_CONTEXT_AQUATIC;
+  }
+
+Encounter "exact young adult dragon"
+  {
+    CR: 1+;
+    Parts:
+      * 1 of any MA_ALL $"young adult" [EP_NOXCR];
+    Flags: NF_NOGEN, NF_SINGLE, NF_CONTEXT_AQUATIC;
+  }
+
+Encounter "exact adult dragon"
+  {
+    CR: 1+;
+    Parts:
+      * 1 of any MA_ALL $"adult" [EP_NOXCR];
+    Flags: NF_NOGEN, NF_SINGLE, NF_CONTEXT_AQUATIC;
+  }
+
+/* inc-pu6v.9 phase 7 (spec docs/specs/2026-10-17-maeve-phase7-summons.md
+   section 5, R42/R113): the data-only "Fierce" template Maeve's summons
+   outcome adds. Any creature type (the `for 0` form "swarm" uses): CR +1,
+   to-hit +2, damage +2, no alignment flags. Appended at the END of main.irc
+   by design -- an rID is a position, and main.irc compiles after every
+   #include, so this Template, and nothing else, sits last in its array; it
+   follows "well-traveled" above. Phase 7b declares it only; no call adds it
+   yet. */
+Template "Fierce" : TM_NATURE for 0
+  {
+    CR: +1;
+    Hit: +2;
+    Dmg: +2;
+  }
