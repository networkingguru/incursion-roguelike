      /* inc-pu6v.129: retired fields -- FavPenalty and PrayerTimeout are
         gone (see the field declaration above, ruled 2026-10-02); tags
         441/442 stay reserved, never reused, and MUST still be read so an
         unknown-tag refusal does not fire on an older v1 save that carries
         them (docs/SAVE-SCHEMA-SPEC.md). They land in these LOCAL scratch
         arrays and go nowhere -- never into AidWaitEnd. Always zero on
         save: nothing in this binary ever has real data for them again. */
      int16 exFavPenalty[MAX_GODS] = { 0 };
      int16 exPrayerTimeout[MAX_GODS] = { 0 };
      FIELD_ARRAY("exFavPenalty", exFavPenalty, sizeof(int16), MAX_GODS);
      FIELD_ARRAY("exPrayerTimeout", exPrayerTimeout, sizeof(int16), MAX_GODS);
      FIELD_ARRAY("HateLev", HateLev, sizeof(int16), MAX_GODS);
@@@ next hunk
      /* AidWaitEnd uses tag 451. Tag 448 belongs to master's Spells[] array
         (inc-vqla), so the epic's earlier uses of 448 and 449 never reached
         a released save and are retired; tag 449 is discarded the same way
         as 441/442 above. */
      FIELD_ARRAY("AidWaitEnd", AidWaitEnd, sizeof(uint32), MAX_GODS);
      uint32 exAidWaitStart[MAX_GODS] = { 0 };
      FIELD_ARRAY("exAidWaitStart", exAidWaitStart, sizeof(uint32), MAX_GODS);
      /* inc-pu6v.37: tag 450 is the next unused number in this class's
         range. An old save lacking it leaves GodlessXP at the zero the
         constructor gave it (docs/SAVE-SCHEMA-SPEC.md: a known tag the
         reader does not meet keeps its constructed value). */
      FIELD_U32("GodlessXP", GodlessXP);
