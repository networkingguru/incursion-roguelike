
God "Paralyzed Sheet Test God"
  {
    Lists:
      * FAVOUR_CHART 1000 50000 60000 70000 80000 90000
          100000 110000 120000 130000;
    On Event EV_BLESSING {
      if (EActor->getGodLevel($"Paralyzed Sheet Test God") == 1)
        EActor->GainTempStati(PARALYSIS,NULL,100,SS_ATTK,0,0);
      return NOTHING;
      };
  }
