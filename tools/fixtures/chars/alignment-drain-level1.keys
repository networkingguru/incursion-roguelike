# inc-qaav4: derive a level-1, 0-XP Chaotic Good warrior fixture. Its only change from the base
# fixture is that wizard mode is switched on, so a check's [w] opens the wizard menu directly.
# INCURSION_LOAD=tools/fixtures/chars/quality-item-magic-seed5-opt0822.sav \
# tools/make_char_fixture.sh alignment-drain-level1 tools/keys/alignment-drain-level1-fixture.keys 5 tools/fixtures/options-2026-08-22.dat
@until "Wizard Mode Options" w y
@choose "Genocide Everything"
d
@expect "Align  Chaotic Good"
@expect "XP     0"
@dump:fixture-level1
ESC
ESC
@expect "System Menu"
b
@dump:saved
