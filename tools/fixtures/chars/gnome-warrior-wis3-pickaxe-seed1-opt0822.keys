# Build and save the character tools/check_dig_zero_skill.sh loads (bd inc-inr80).
#
#   tools/make_char_fixture.sh gnome-warrior-wis3-pickaxe-seed1-opt0822 \
#       tools/keys/gnome-warrior-pickaxe-save.keys 1 \
#       tools/fixtures/options-2026-08-22.dat
#
# This script ends with the System Menu's [b] Save and Continue, which is the
# one save tools/make_char_fixture.sh accepts.
#
# THE BUCKLER. A generated gnome warrior starts with a buckler in the Ready
# Hand, and the pickaxe needs both hands, so the script stows the buckler into
# the pack ('i', 'a', SPACE, 's') before it wields the pickaxe.
#
# WHY A GNOME WARRIOR WITH WISDOM 3. SkillLevel(SK_MINING) (src/Create.cpp) has
# no floor of 1. For this character every term of it is known and they sum to
# zero:
#
#   ranks               0   Mining is never trained here
#   s_train            +2   Mining is a gnome race skill (lib/races.irh)
#   s_racial            0   the gnome template, alone among the five races that
#                           have Mining, carries no Stati[SKILL_BONUS,35]
#                           -- the kobold and dwarf templates both carry +2
#   s_kit              +2   the pickaxe is Mining's skill kit, SKILL_KIT_MOD +2
#   Mod2(min(WIS,STR)) -4   Mining takes the WORSE of Wisdom and Strength, and
#                           this character's Wisdom is 3
#
# Wisdom 3 comes from point buy ([p] on the attribute screen), which is why the
# stats below are typed rather than chosen from a rolled set: base Wisdom 5 plus
# the gnome's -2. Every other attribute is bought up because point buy will not
# release the character while a point is unspent.

a       # Initial Choices: [a] Create a New Character
n       # Alter the character generation options? -- no
y       # Your options will place the game in Explore Mode. Continue? -- yes

@choose "Gnome"
@choose "Gnome (Standard)"
@choose "Warrior"

p       # Abort to Point Buy; every attribute starts at 8, with 75 points
        # STR 9, DEX 18, CON 18, INT 18, WIS 5, CHA 18, LUC 17 == exactly 75
RIGHT DOWN RIGHT*10 DOWN RIGHT*10 DOWN RIGHT*10 DOWN LEFT*3 DOWN RIGHT*10 DOWN RIGHT*9
ENTER
y       # Are these your final stats? -- yes

@choose "Neutral"
a       # First feat
a       # Second feat
a       # Focus on which weapon

# Skill Manager. Nine ranks, spent on the first five rows (the exact rows do not matter),
# and Mining is far below them in the list and MUST NOT
# receive a rank; one rank in it makes this script measure nothing.
RIGHT*3 DOWN RIGHT*3 DOWN RIGHT*3 DOWN RIGHT*3 DOWN RIGHT*3 DOWN
ENTER y

@while "wish to worship" y
@choose "The Disciplined Expert"

ESC     # the keystroke that lands in the dungeon

# Stow the buckler, then move the pickaxe from the right shoulder into the
# weapon hand. Creature::Dig tests InSlot(SL_WEAPON), so carrying it is not
# enough.
i
a
SPACE
s
ESC
i
f
SPACE
b
SPACE
f
SPACE
@dump:wielded
ESC

ESC                     # System Menu -- and NOT a cancel
@expect "System Menu"
b                       # [b] Save and Continue
@dump:saved
# No @quit: it would save a second time (see tools/keys/lizardfolk-monk-save.keys).
