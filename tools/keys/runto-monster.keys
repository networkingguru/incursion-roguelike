# Case M of tools/check_runto_hazards.sh, bd inc-vmpk: a Large monster follows
# the character by path search, and the short route crosses a region too small
# for it.
#
#   INCURSION_RUNTO_PROBE=1 INCURSION_RUNTO_STAGE=M \
#   INCURSION_OPTIONS=tools/fixtures/options-2026-08-22.dat \
#   INCURSION_LOAD=tools/fixtures/chars/kobold-rogue-seed1.sav \
#       tools/headless.sh tools/keys/runto-monster.keys 3
#
# [l] [o] opens the overview map, and opening it builds the scene
# (src/RunToProbe.cpp). ESC closes it. The character then stands still for
# thirty turns; the probe log records the ogre's square at each decision.

.*2
l o
ESC
@dump:scene
s*30
@dump:after-wait
@quit
