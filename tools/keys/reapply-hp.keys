@dump:c3-a1
ENTER RIGHT
@dump:c3-a2
ENTER RIGHT
@dump:c3-a3
ENTER RIGHT
@dump:c3-a4

ENTER
w
@choose "Genocide Everything"

ENTER
u
@choose "Innate Divine Sacrifice" 5

ENTER
w
@choose "Monster Summoning"
@choose "Beasts"
@choose "froghemoth"
RIGHT ENTER
@dump:c4-summoned

ENTER RIGHT
@dump:c4-a1
ENTER RIGHT
