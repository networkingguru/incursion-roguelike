@choose "Monster Summoning"
@choose "Beasts"
@choose "froghemoth"
RIGHT ENTER
@dump:c1-summoned

RIGHT
@while "Confirm attack" y
@dump:c1-a1
ENTER RIGHT
@dump:c1-a2
ENTER RIGHT
@dump:c1-a3
ENTER RIGHT
@dump:c1-a4

ENTER
