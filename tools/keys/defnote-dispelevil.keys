# inc-7v2i: learn Dispel Evil through the wizard menu, cast it, and read the
# sidebar and the character sheet.
#
#   INCURSION_OPTIONS=tools/fixtures/options-2026-08-22.dat \
#   INCURSION_LOAD=tools/fixtures/chars/orc-mage-seed4-gate.sav \
#       tools/headless.sh tools/keys/defnote-dispelevil.keys 4
#
# Read by tools/check_defnote.sh. The spell is a priest spell, and the fixture
