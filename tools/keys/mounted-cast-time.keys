# inc-2zpv6: cast Shield (self-only, somatic) and read the turn counter before
# and after, mounted or not. Loaded by tools/check_mounted_cast_time.sh with
# orc-mage-seed1-opt0822. The check turns on a line by stripping its prefix:
# "#M# " mounts a horse first, "#S# " casts the spell still. @GOD@ is the
# scratch god whose blessing sets Ride and Balance.
w
@while "Enter wizard mode" y
@choose "Genocide Everything"
w
@choose "Monster Summoning"
@choose "Quadrupeds"
@choose "horse"
RIGHT ENTER
w
@choose "Make Player Master of Monster"
RIGHT ENTER
SPACE
w
@choose "Become Divine Champion"
"@GOD@" ENTER
@while "more --" SPACE
@while "ESC:Done" ESC
#M# y
#M# @choose "Mount"
#M# RIGHT ENTER
#M# SPACE
@dump:ready
m
@cursorto:mark "Shield" DOWN
#S# S
ENTER
@until "HP:" ESC
@dump:cast
v
@dump:msgs
ESC
@quit
