# Mindless monster (plague of rats), pacified.
# Read by tools/check_peaceful_mindless.sh (bd inc-nypm). Loads the frozen
# Wood Elf Druid (already in wizard mode: 'w' opens the menu with no prompt),
# summons one monster west of the player, optionally pacifies it with Animal
# Empathy ('u', then 'p' = Pacify), waits three turns, then LOOKs at it. The
# look line is the observation: "peaceful" alone means it is friendly to the
# player; "hostile formerly peaceful" means MS_PEACEFUL is set yet the monster
# still rates the player Enemy (src/Message.cpp:1038, src/Target.cpp:566).
ENTER
w
@choose "Monster Summoning"
@choose "Rodents"
@choose "plague of rats"
LEFT ENTER
u
@choose "Animal Empathy"
# Pick the pacify target by name too: LEFT alone takes the nearest creature west,
# which is not the summoned one if another creature stands nearer.
@until "A plague of rats" UP
@until "A plague of rats" RIGHT
@until "A plague of rats" DOWN
@until "A plague of rats" LEFT
@expect "A plague of rats"
ENTER
p
@dump:after-pacify
.*3
# Select the monster by name, not by an offset: where a summon lands is not fixed.
# t = target mode; the first arrow press picks the nearest candidate in that
# direction, later presses walk the ring. Each @until stops once the look line
# shows the name; "uninjured" keeps it off the side legend, which lists the name too.
l
t
@until "uninjured plague of rats" UP
@until "uninjured plague of rats" RIGHT
@until "uninjured plague of rats" DOWN
@until "uninjured plague of rats" LEFT
@expect "uninjured plague of rats"
@dump:look
ESC
