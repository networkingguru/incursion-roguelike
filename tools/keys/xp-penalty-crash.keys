# Wood Elf Rogue 1 on a loaded character, then Rogue 2 / Warrior 1 by wizard level-ups.
# tools/check_xp_penalty.sh sets INCURSION_LOAD to the fixture wood-elf-rogue-seed7-opt0818,
# built by tools/keys/wood-elf-rogue-save.keys, so no seed decides his skill ranks.
# The first key is one real turn: after a load the first menu key does not open without it.
s
w
y
w
DOWN DOWN
SPACE
ESC
d
@until "Class  Rogue 2" G
M
@choose "Warrior"
@until "class do you wish to advance" G
@choose "Warrior"
@until "Warrior 1" a
@dump:crashed
# Leave the sheet and wait one turn. tools/headless.sh exits 5 (NO GAMEPLAY)
# for a run that plays no turn, and tools/check_xp_penalty.sh needs exit 0.
# The sheet is dumped first, so these keys cannot change it. bd inc-jnnp.
ESC
.
@quit
