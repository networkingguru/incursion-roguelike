# Reproduction only for inc-aiw5; no game-code or data changes.
# Run from repository root, with a fresh INCURSION_RUN_DIR under logs/:
# INCURSION_OPTIONS=tools/fixtures/options-2026-08-22.dat \
#   INCURSION_RUN_DIR="$PWD/logs/inc-aiw5/control" \
#   tools/headless.sh tools/keys/caustic-vitae-control.keys 1
#
# The control for tools/keys/caustic-vitae-acid.keys: the same cast, the same
# character, the same level, but the victim is a hill giant (lib/mon2.irh:2372,
# HD 12, Con 19, never under 78 hit points, so 2D of at most 20 cannot kill
# it) with no acid resistance at all. It must take the full damage both
# before and after the fix, and its message must name the spell's own damage
# type (Acid) after the fix -- the acid-immune run is read against this.
#
# Every choice and its reason is the acid script's; see that file's header.
# The character is LOADED, not generated (INCURSION_LOAD, set by
# tools/check_caustic_vitae_acid.sh): tools/fixtures/chars/orc-mage-seed1-opt0822.sav,
# the male orc mage chargen-mage.keys builds, WIS 16 (mod +3). Nothing here
# reads a rolled attribute.
@until "Things in View" ESC

w
y
@choose "Wizard Mode Switches"
DOWN*2 SPACE   # Free Advancement
DOWN*5 SPACE   # Infinite Mana
DOWN*3 SPACE   # Freeze Monsters
ESC

d
G
@while "Bonus To Which Attribute" a
@while "Choose a feat" a
@while "Choose a bonus metamagic Feat" a
@while "You feel" ESC
SPACE
@dump:state

w
@choose "Learn Any Spell"
"Caustic Vitae"
ENTER
@dump:learned

# Clear the level first, so the summoned monster is the only other thing the
# Examine screen can reach in one RIGHT, whatever the level holds.
w
@choose "Genocide Everything"
SPACE*40                 # dismiss the genocide message chain

w
@choose "Monster Summoning"
@choose "Giants"
@choose "hill giant"
RIGHT*4 ENTER
@dump:summoned

w
@choose "Examine Nearby Things"
@dump:target-before-player
@until "T_MONSTER" RIGHT   # skip the corpses Genocide left; the victim is the one monster
@dump:target-before
ESC

m
@choose "Caustic Vitae"
D
RIGHT
@while "more --" SPACE
@dump:after
v
@dump:messages
ESC

w
@choose "Examine Nearby Things"
@dump:target-after-player
@until "T_MONSTER" RIGHT   # skip the corpses Genocide left; the victim is the one monster
@dump:target-after
ESC

@quit
