# inc-nk27: full-topic help from the title menu; no character or world.
# tools/gates/Options.Dat selects BOOK help. PGDN*512 exceeds the
# 8192-line scroll buffer at the headless screen height. One more page
# and a second dump let the check verify that scrolling has stopped.
@choose "General Help"
@choose "Race Descriptions"
@dump:race-help-start
PGDN*512
@dump:race-help-end
PGDN
@dump:race-help-end-confirm
@quit
