# Everything in dive.keys after character creation. This script starts in play,
# either after chargen.keys ran or after a fixture load (INCURSION_LOAD).

@dump:arrival

@while "You die... Die?" n
w y p "2" ENTER
.*19 s .*2
@while "You die... Die?" n
w p "3" ENTER
.*17 s .*2
@while "You die... Die?" n
w p "4" ENTER
.*13 s .*2
@while "You die... Die?" n
w p "5" ENTER
.*24 s .*2
@while "You die... Die?" n
w p "6" ENTER
@dump:depth6
.*17 s .*2
@while "You die... Die?" n
w p "7" ENTER
.*17 s .*2
@while "You die... Die?" n
w p "8" ENTER
.*13 s .*2
@while "You die... Die?" n
w p "9" ENTER
.*17 s .*2
@while "You die... Die?" n
w p "10" ENTER
.*17 s .*2
@while "You die... Die?" n
w p "10" ENTER
.*22 s .*2
@while "You die... Die?" n
w p "8" ENTER
.*15 s .*2
@while "You die... Die?" n
w p "6" ENTER
@dump:depth6
.*19 s .*2
@while "You die... Die?" n
w p "4" ENTER
.*19 s .*2
@while "You die... Die?" n
w p "2" ENTER

@while "#------" SPACE
@dump:final
@quit
