@choose "Warrior"
a
d
@while "Choose a feat" a
@while "Focus on which Weapon" a
@while "Choose a feat" a
@while "Focus on which Weapon" a
@while "|  *" RIGHT RIGHT RIGHT DOWN
ENTER y
@while "wish to worship" y
@while "Choose a God" a
@while "|  *" RIGHT RIGHT RIGHT DOWN
ENTER y
@while "personality archetype" a
@until "System Menu" ESC
ESC
@until "Wizard Mode Options" w y
@choose "Genocide Everything"
ESC
