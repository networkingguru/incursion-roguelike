# Key script for tools/check_weapon_types.sh, INCURSION_WEAPONTYPE_PROBE=kysul.
#
# The probe runs two forced Kysul pulses (INCURSION_GENITEM_FORCE control). Each
# pulse shows one message box that waits for a key. The script supplies a few
# spare keys, then one search so the run counts as a session (see
# load-char-sheet.keys).
SPACE*6
s
