# Step the target cursor with the arrow keys, one run per arrow, and let
# tools/check_target_order.sh read the order from the probe log. This is the
# oracle for inc-upw.26 (the stride defect) and inc-3ybbz (slice order).
#
#   INCURSION_TARGET_PROBE=1 INCURSION_OPTIONS=tools/fixtures/options-2026-08-18.dat \
#   INCURSION_LOAD=tools/fixtures/specimens/orc-barbarian-seed1-opt0818.sav \
#       tools/headless.sh tools/keys/target-ring.keys 1
#
# The run loads a frozen character, saved on arrival in the Goblin Caves entry
# chamber: the player stands at (111,110) with nine corpses in view and no live
# monster, which is all the test needs. The arrows cycle whatever the prompt
# considers a target, and Look considers all of them. Look and the target
# cursor take no game turn, so nothing moves and nothing rolls.
#
# [l] opens the Look prompt on the location cursor. [t] switches it to the
# target cursor, which starts on the player. Four runs follow, each started by
# a different arrow: RIGHT (twelve presses, more than one lap of nine), UP
# (twelve), DOWN (three) and PGUP, the north-east diagonal (three). A press of
# another arrow starts a new run at that arrow's own slice.

@dump:arrival

l                   # Look -- the location cursor
t                   # switch to the target cursor, on the player
@dump:target-on-player

RIGHT*12            # run 1, east slice first, more than one lap
@dump:right
UP*12               # run 2, north slice first -- not where RIGHT stopped
@dump:up
DOWN*3              # run 3, south slice first
@dump:down
PGUP*3              # run 4, the north-east diagonal (PGUP is NE)
@dump:northeast

ESC
@quit
