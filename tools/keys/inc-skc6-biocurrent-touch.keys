# Diagnostic repro for inc-skc6: a magic touch attack (the innate power
# Biocurrent) prints garbage in the combat readout's Damage line. Follows the
# recipe already proven by tools/keys/sanctuary-strike.keys for wizard-mode
# spell grant + Spell Manager cast + Monster Summoning + a scripted melee
# attack.
#
#   INCURSION_OPTIONS=tools/fixtures/options-2026-08-22.dat \
#       tools/headless.sh tools/keys/inc-skc6-biocurrent-touch.keys 1
#
# THIS IS A THROWAWAY DIAGNOSTIC SCRIPT, not a committed check.

# The character is a LOADED fixture (INCURSION_LOAD, set by tools/check_skc6_blast_text.sh):
# an orc priest of Aiswin already standing on the saved map, so no chargen runs.

w
y
@choose "Wizard Mode Switches"
DOWN*10
SPACE
ESC

w
@choose "Learn Any Spell"
"Biocurrent"
ENTER

m
@choose "Biocurrent"
@dump:after-cast

w
@choose "Monster Summoning"
@choose "Animals"
@choose "giant rat"
RIGHT
ENTER

@dump:after-summon

RIGHT
@while "Confirm attack" y
@dump:after-strike1

RIGHT
@while "Confirm attack" y
@dump:after-strike2

v
@dump:message-log
@while "Messages" ESC
@quit
