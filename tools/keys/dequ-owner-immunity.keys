# Give the character total immunity to rust, then read his maul's page before
# and after five mud-elemental retaliations (bd inc-w26h).
#
#   tools/check_dequ_owner_immunity.sh
#
# WHAT IS BEING MEASURED. Soak and rust defences protect the owner's gear
# regardless of the grant's flag; other damage types require EF_PROTECTS_ITEMS.
# This checks the blanket rust half: the immune owner's maul stays undamaged.
# The rust case in src/Fight.cpp:7041-7072 damages an item and never costs the
# creature hit points, so a wearer-only rust grant would be a no-op.
#
# WHY THESE GAUNTLETS. "Rust;gauntlet" (lib/m_items.irh:4348) grants total
# immunity to rust, decay and soak. The sheet must show Rusting under Complete
# Immunities. These gauntlets also carry EF_PROTECTS_ITEMS, so either route
# protects the maul; the check's mutation breaks their shared delivery point
# in Item::Damage rather than either route in GearResistLevel.
#
# WHY A SMALL MUD ELEMENTAL. Its A_DEQU is 1d6 AD_RUST (lib/mon4.irh:2396) and
# iron has hardness 0 against rust, so every retaliation that lands does its
# whole roll when unprotected. Frozen monsters still retaliate on a hit.
#
# WHY A MAUL. It has 262 hit points, the heaviest ordinary weapon in lib/, so
# five retaliations cannot destroy it and leave no page to read. It is iron,
# which is what rusts.
#
# ONE ELEMENTAL PER BLOW, for the reason tools/keys/dequ-hardness-plain.keys
# sets out: a blow that kills its target leaves no item for the retaliation to
# aim at.

@include dequ-setup.keys

# --- the gauntlets that make the character immune to rust ---
w
@choose "Item Acquisition"
RIGHT*17                # walk the glyph row to gauntlets
@until "Rust" DOWN
DOWN                    # the wanted row is the middle of three; step onto it
ENTER
p                       # Gauntlets
SPACE
@until "Things in View" ESC

# --- the weapon that will be rusted ---
w
@choose "Item Acquisition"
RIGHT*9                 # walk the glyph row to ordinary weapons
@until "Maul" DOWN
DOWN
ENTER
b                       # Weapon Hand
SPACE
@while "two-handed" y
s                       # stow the starting knife the swap pushed into the air
@until "SPACE:Swap" i
@until ">>b)Weapon" b
@until "base value of" x
@dump:immune-before
@until "Things in View" ESC

# The character sheet's Resistances page, as evidence that the immunity is
# really on him and not merely bought.
d
@until "Resistances and Armour" DOWN
@dump:immune-sheet
@until "Things in View" ESC

w
@choose "Monster Summoning"
@choose "Elementals"
@choose "small mud elemental"
RIGHT ENTER
RIGHT
@while "Attack the" y
@while "more --" SPACE
@dump:immune-strike-1

w
@choose "Monster Summoning"
@choose "Elementals"
@choose "small mud elemental"
RIGHT ENTER
RIGHT
@while "Attack the" y
@while "more --" SPACE
@dump:immune-strike-2

w
@choose "Monster Summoning"
@choose "Elementals"
@choose "small mud elemental"
RIGHT ENTER
RIGHT
@while "Attack the" y
@while "more --" SPACE
@dump:immune-strike-3

w
@choose "Monster Summoning"
@choose "Elementals"
@choose "small mud elemental"
RIGHT ENTER
RIGHT
@while "Attack the" y
@while "more --" SPACE
@dump:immune-strike-4

w
@choose "Monster Summoning"
@choose "Elementals"
@choose "small mud elemental"
RIGHT ENTER
RIGHT
@while "Attack the" y
@while "more --" SPACE
@dump:immune-strike-5

@until "SPACE:Swap" i
@until ">>b)Weapon" b
@until "base value of" x
@dump:immune-after
@until "Things in View" ESC
@quit
