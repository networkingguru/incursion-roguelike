# inc-zzwm: make a Orc Rogue and stop in the arrival room, so the creation kit
# arrangement can be read from INCURSION_KIT_PROBE. Read by
# tools/check_kit_arrangement.sh. Race and class are named, not counted;
# feats are taken by counted letter, so judge the build by the probe's
# KIT_PROBE line, not by this script.

a       # Initial Choices: [a] Create a New Character
n       # Alter the character generation options? -- no
y       # Your options will place the game in Explore Mode. Continue? -- yes

@choose "Orc"
@choose "Orc (Standard)"
@choose "Rogue"
p       # Attributes: abort to Point Buy, so no roll and no perk decides the build (inc-b4l3g.20)
RIGHT*6 DOWN RIGHT*8 DOWN RIGHT*10 DOWN RIGHT*10 DOWN RIGHT*4 DOWN RIGHT*8 DOWN RIGHT*9
ENTER   # every point spent
y       # Are these your final stats? -- yes
a       # Alignment: the first offered

@while "Choose a feat" a

RIGHT*3 DOWN RIGHT*3 DOWN RIGHT*3 DOWN RIGHT*3 DOWN RIGHT*3 DOWN RIGHT*3 DOWN
RIGHT*3 DOWN RIGHT*3 DOWN RIGHT*3 DOWN RIGHT*3 DOWN RIGHT*3 DOWN RIGHT*3 DOWN
ENTER y # Done, and confirm keeping the ranks

@while "wish to worship" y
@while "personality archetype" a

ESC*3   # dismiss the arrival room description
s*3     # one turn, so the session counts as played
@quit
