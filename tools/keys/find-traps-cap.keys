@while "Choose a feat" a
@while "Choose a bonus" a
@while "Focus on which Weapon" a
@while "You feel" ESC
@while "more --" SPACE
G
@while "Bonus To Which Attribute" a
@while "Choose a feat" a
@while "Choose a bonus" a
@while "Focus on which Weapon" a
@while "You feel" ESC
@while "more --" SPACE
@dump:level
ESC
w
@choose "Learn Any Spell"
"Find Traps" ENTER
d
@dump:sheet-before
W
"find-traps-before" ENTER
S
@cursorto:mark "Searching" DOWN
@dump:search-before
ESC y
ESC
m
@choose "Find Traps"
@while "more --" SPACE
@dump:cast
d
@dump:sheet-after
W
"find-traps-after" ENTER
S
@cursorto:mark "Searching" DOWN
@dump:search-after
ESC y
ESC
@quit
