# Reproduction only for inc-8mg9; no game-code or data changes.
# Run from repository root, with a fresh INCURSION_RUN_DIR under logs/:
# INCURSION_OPTIONS=tools/fixtures/options-2026-08-22.dat \
#   INCURSION_RUN_DIR="$PWD/logs/inc-8mg9/cap-fresh" \
#   tools/headless.sh tools/keys/find-traps-cap.keys 1
# Route: chargen-priest, wizard Free Advancement, Priest 11.
# Learn Any Spell sets SP_INNATE. CalcEffect (src/Magic.cpp) therefore uses
# ChallengeRating (sum of character class levels), then adds the sheet's
# Divination +1: effective Find Traps caster level 12, not 11.
# Observed Search: +2 before, +14 after, delta +12.
# W writes full sheets beneath the run's logs/; @dump captures skill totals.
# Search has zero ranks and is omitted from the full sheet before the cast.
# ESC y aborts the skill manager without allocating any ranks.
@include chargen-priest.keys
ESC
w y
@choose "Wizard Mode Switches"
DOWN*2 SPACE # Free Advancement
DOWN*5 SPACE # Infinite Mana
DOWN*3 SPACE # Freeze Monsters
ESC
d
G
@while "Bonus To Which Attribute" a
@while "Choose a feat" a
@while "Choose a bonus" a
@while "Focus on which Weapon" a
@while "You feel" ESC
@while "more --" SPACE
G
@while "Bonus To Which Attribute" a
@while "Choose a feat" a
@while "Choose a bonus" a
@while "Focus on which Weapon" a
@while "You feel" ESC
@while "more --" SPACE
