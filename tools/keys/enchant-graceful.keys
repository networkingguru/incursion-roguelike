# Acquire all three Enchant Armour quality scrolls, the Staff of the Goblin
# Queen, the Staff of Exorcism, the Staff of Abjuration and the Staff of Wind
# and Water with wizard
# Auto-Identify on, then open each player-facing description
# from Inventory Mode. Read by tools/check_enchant_graceful.sh for PA-08-F26,
# PA-08-F27, PA-08-F29, PA-08-F30, PA-08-F31 and PA-08-F32 / inc-tek.8.8.
#
# Scrolls are one RIGHT from Potions in ItemGlyphs (src/Tables.cpp:320-322).
# The acquisition list shows three rows with the middle selected, so looking
# for the following scroll leaves the wanted scroll selected. The check does
# not trust that ordering: each description box must name its own scroll.

@include chargen.keys

w
y
@choose "Wizard Mode Switches"
DOWN
SPACE                   # Auto-Identify Items
ESC

w
@choose "Item Acquisition"
RIGHT                   # Scrolls
@until "Enchant Armour (life-keeping)" DOWN
ENTER                   # graceful is the selected preceding row
s
ESC

i
0
6                       # first pack-contained item: graceful scroll
@expect "Scroll of Enchant Armour (graceful)"
x
@dump:graceful
ESC
ESC

w
@choose "Item Acquisition"
RIGHT                   # Scrolls
@until "Enchant Armour (graceful)" DOWN
ENTER                   # featherlight is the selected preceding row
s
ESC

i
0
6                       # featherlight sorts before the graceful scroll
@expect "Scroll of Enchant Armour (featherlight)"
x
@dump:featherlight
ESC
ESC

w
@choose "Item Acquisition"
RIGHT                   # Scrolls
@until "Enchant Armour (fortification)" DOWN
ENTER                   # life-keeping is the selected preceding row
s
ESC

i
0
6                       # featherlight is the first pack-contained scroll
DOWN
DOWN                    # life-keeping sorts after graceful
@expect "Scroll of Enchant Armour (life-keeping)"
x
@dump:life-keeping
ESC
ESC

w
@choose "Item Acquisition"
RIGHT*3                 # Staves
@until "Staff of the Goblin Queen" DOWN
DOWN                    # the wanted row is below the selected Spider staff
ENTER
2                       # Enter Item Level
ENTER
b
SPACE                   # swap the staff into the Weapon Hand
s                       # stow the starting knife left in the air slot
ESC

i
b
@expect "Staff of the Goblin Queen"
x
@dump:goblin-queen
ESC
ESC

w
@choose "Item Acquisition"
RIGHT*3                 # Staves
@until "Staff of Exorcism" DOWN
DOWN                    # the wanted row is below the selected preceding staff
ENTER
2                       # Enter Item Level
ENTER
b
SPACE                   # swap the staff into the Weapon Hand
s                       # stow the Goblin Queen staff left in the air slot
ESC

i
b
@expect "Staff of Exorcism"
x
@dump:exorcism
ESC
ESC

w
@choose "Item Acquisition"
RIGHT*3                 # Staves
@until "Staff of Abjuration" DOWN
DOWN                    # the wanted row is below the selected preceding staff
ENTER
2                       # Enter Item Level
ENTER
b
SPACE                   # swap the staff into the Weapon Hand
s                       # stow the Exorcism staff left in the air slot
ESC

i
b
@expect "Staff of Abjuration"
x
@dump:abjuration
ESC
ESC

w
@choose "Item Acquisition"
RIGHT*3                 # Staves
@until "Staff of Wind and Water" DOWN
DOWN                    # the wanted row is below the selected preceding staff
ENTER
2                       # Enter Item Level
ENTER
b
SPACE                   # swap the staff into the Weapon Hand
s                       # stow the Abjuration staff left in the air slot
ESC

i
b
@expect "Staff of Wind and Water"
x
@dump:wind-water
ESC
ESC
@quit
