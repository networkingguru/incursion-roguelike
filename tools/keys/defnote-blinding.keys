# inc-7v2i: wear padded armor with the blinding quality, then read the sidebar
# and the character sheet.
#
#   INCURSION_OPTIONS=tools/fixtures/options-2026-08-22.dat \
#   INCURSION_LOAD=tools/fixtures/chars/orc-mage-seed4-gate.sav \
#       tools/headless.sh tools/keys/defnote-blinding.keys 4
#
# Read by tools/check_defnote.sh. The wizard menu gives the armor and the
# quality (src/Debug.cpp cases 4 and 13). The quality is an EA_GRANT, so the
# armor comes off and goes on again, as tools/keys/cloak-resistance.keys does.

@dump:arrival

w
y
@choose "Item Acquisition"
RIGHT*15                # Armours
ENTER                   # pick the first row: padded armour
ENTER                   # wear it in the armour slot
ESC

w
@choose "Add Quality to Armour"
A Q _ B L I N D I N G ENTER

w
@choose "All Creatures CalcValues"

i
j
SPACE                   # take the armor off
j
SPACE                   # put it on again, so the grant applies
ESC
@dump:after

d
@expect "Defense Class"
@dump:sheet
ESC
