# Behavioural fixture for inc-q3r5: target death must collapse its double.
# The double retains references to both target and caster.

@include chargen.keys

w
y
@choose "Genocide Everything"

# One square of shallow water, one step east of the player.
w
@choose "Change terrain type"
RIGHT ENTER
TAB
@choose "shallow water"
@dump:pool

# The victim stands in it.
w
@choose "Monster Summoning"
@choose "Reptiles"
@choose "giant tortoise"
RIGHT ENTER
@dump:victim

# The caster is the player.
w
@choose "Learn Any Spell"
"Watery Double" ENTER
@dump:learned

m
@choose "Watery Double"
@dump:target-prompt
RIGHT
@dump:target-picked
ENTER
@dump:after-cast

# At seed 20260905, 26 wait commands let the double kill its target before
# spell expiration. History preserves the collapse amid the combat messages.
.*26
@dump:after-kill
v
@dump:kill-messages
@expect "collapses back to inanimate water"
ESC
.
@dump:after-turn
