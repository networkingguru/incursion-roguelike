# Behavioural fixture for inc-fiiq: reference cleanup must deliver EV_REMOVED.
#
# The player learns Watery Double, floods one square, summons a giant tortoise
# into it and casts the spell at the tortoise.  The cast leaves the caster
# holding EFF_FLAG1 whose stati object is the tortoise (lib/wspells.irh:7648),
# and leaves the double holding EFF_FLAG2 whose stati object is the caster
# (lib/wspells.irh:7657).  Killing the tortoise destroys the object the
# caster's row refers to, so Thing::CleanupRefedStati reaches that row.
#
# With the fix the row goes through RemoveEffStati(eID, EV_REMOVED, ...) and the
# spell's own EV_REMOVED handler runs.  Without it the row is dropped silently.

@include chargen.keys

w
y
@choose "Genocide Everything"

# One square of shallow water, one step east of the player.
w
@choose "Change terrain type"
RIGHT ENTER
TAB
@choose "shallow water"
@dump:pool

# The victim stands in it.
w
@choose "Monster Summoning"
@choose "Reptiles"
@choose "giant tortoise"
RIGHT ENTER
@dump:victim

# The caster is the player.
w
@choose "Learn Any Spell"
"Watery Double" ENTER
@dump:learned

m
@choose "Watery Double"
@dump:target-prompt
RIGHT
@dump:target-picked
ENTER
@dump:after-cast

# Kill the object the caster's row refers to.
w
@choose "Genocide Everything"
@dump:after-kill
s
@dump:after-turn
