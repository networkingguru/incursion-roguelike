# inc-r6u1 control: Searing Light at effective caster level 6 (Priest 6,
# ChallengeRating 6, no school bonus from Aiswin's Fate domain). At this level
# both dice formulas are BELOW their caps and the fix must change nothing:
#   living   (giant rat): LEVEL_SCALED2(6) = 3  -> LEVEL_1PER2_MAX5 = min(5,3) = 3
#   undead   (mummy):     LEVEL_SCALED(6)  = 6  -> LEVEL_MAX10       = min(10,6) = 6
# So the before/after damage lines are 3d8+bonus and 6d6+bonus on both builds,
# proving the cap constants did not switch the spell off below their ceilings.
#
# inc-stzd: Searing Light's own to-hit roll is a normal d20 attack, so one
# cast in twenty misses on a natural 1 and prints no Damage line -- the
# living cast is cast TWICE below so a single bad roll does not starve the
# whole section. The giant rat is also left alive by a miss, and the undead
# section used to cast "RIGHT" at whatever still stood there instead of the
# freshly summoned mummy; Genocide Everything clears the board between the
# two casts so the second one can only hit the mummy.
#
#   INCURSION_OPTIONS=tools/fixtures/options-2026-08-22.dat \
#   INCURSION_RUN_DIR="$PWD/logs/inc-r6u1/control" \
#       tools/headless.sh tools/keys/searing-light-control.keys 1
@include chargen-priest.keys
ESC
w y
@choose "Wizard Mode Switches"
DOWN*2 SPACE
DOWN*5 SPACE
DOWN*3 SPACE
ESC
d
G
@while "Bonus To Which Attribute" a
@while "Choose a feat" a
@while "Choose a bonus" a
@while "Focus on which Weapon" a
@while "You feel" ESC
@while "more --" SPACE
G
@while "Bonus To Which Attribute" a
@while "Choose a feat" a
@while "Choose a bonus" a
@while "Focus on which Weapon" a
@while "You feel" ESC
@while "more --" SPACE
G
@while "Bonus To Which Attribute" a
@while "Choose a feat" a
@while "Choose a bonus" a
@while "Focus on which Weapon" a
@while "You feel" ESC
@while "more --" SPACE
G
@while "Bonus To Which Attribute" a
@while "Choose a feat" a
@while "Choose a bonus" a
@while "Focus on which Weapon" a
@while "You feel" ESC
@while "more --" SPACE
G
@while "Bonus To Which Attribute" a
@while "Choose a feat" a
@while "Choose a bonus" a
@while "Focus on which Weapon" a
@while "You feel" ESC
@while "more --" SPACE
@dump:level
ESC
w
@choose "Learn Any Spell"
"Searing Light" ENTER
w
@choose "Monster Summoning"
@choose "Animals"
@choose "giant rat"
RIGHT
ENTER
@dump:control-summoned-living
m
@choose "Searing Light"
RIGHT
@while "more --" SPACE
m
@choose "Searing Light"
RIGHT
@while "more --" SPACE
@dump:control-after-living
v
@dump:control-messages-living
@while "Messages" ESC
w
@choose "Genocide Everything"   # the rat (hit or missed) must not take the
@until "HP:" ESC                #   mummy's cast below
w
@choose "Monster Summoning"
@choose "Corporeal Undead"
@choose "mummy"
RIGHT
ENTER
@dump:control-summoned-undead
m
@choose "Searing Light"
RIGHT
@while "more --" SPACE
@dump:control-after-undead
v
@dump:control-messages-undead
@while "Messages" ESC
@quit
