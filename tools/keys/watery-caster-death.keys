# inc-q3r5: confirmed player death, without a crash; target and pony survive.
# This fixture does NOT test caster-loss collapse: player death ends the game.
# tools/keys/watery-monster-caster.keys attempts the monster-caster case.
# Check the headless report: exit 0, 1 confirmed death, no InBounds assertions.
# Run with seed 20260905 and INCURSION_OPTIONS=tools/gates/Options.Dat.

@include chargen.keys

w
y
ESC # Enable wizard mode, then leave its menu without killing anything.

# One square of shallow water, one step east of the player.
w
@choose "Change terrain type"
RIGHT ENTER
TAB
@choose "shallow water"
@dump:pool

# The victim stands in it.
w
@choose "Monster Summoning"
@choose "Reptiles"
@choose "giant tortoise"
RIGHT ENTER
@dump:victim

# A separate, distant bystander; no global kill is used.
w
@choose "Monster Summoning"
@choose "Quadrupeds"
@choose "pony"
LEFT*4 ENTER
@dump:bystander

# The caster is the player.
w
@choose "Learn Any Spell"
"Watery Double" ENTER
@dump:learned

m
@choose "Watery Double"
@dump:target-prompt
RIGHT
@dump:target-picked
ENTER
@dump:after-cast
@expect "B aqueous giant"
@expect "B giant"
@expect "q pony"
@expect "HP:47/47"

# Deterministic self-targeted disintegration. The spell kills the player;
# answer the Explore-mode death confirmation rather than cheating death.
w
@choose "Learn Any Spell"
"Disintegrate" ENTER
m
@choose "Disintegrate"
ENTER
@dump:before-death
@expect "Die? [yn]"
@expect "B aqueous giant"
@expect "q pony"
y
@dump:after-death
@expect "You disintegrate! You die..."
@expect "B giant"
@expect "q pony"
ENTER
@dump:gravestone
@expect "REQUIESCAT IN PACE"
v
@dump:death-messages
# The gravestone and history follow the confirmed death, not an eluded death.
@expect "You disintegrate!"
@expect "You die..."
