# inc-7v2i: cast Shield, then read the sidebar and the character sheet.
#
#   INCURSION_OPTIONS=tools/fixtures/options-2026-08-22.dat \
#   INCURSION_LOAD=tools/fixtures/chars/orc-mage-seed4-gate.sav \
#       tools/headless.sh tools/keys/defnote-shield.keys 4
#
# Read by tools/check_defnote.sh. Shield is a self buff (lib/wspells.irh) and
# asks for no target. The arrival dump shows the sidebar before the cast, so the
# check can compare Def: before and after.

@dump:arrival

m
@choose "Shield"
@dump:cast

d                       # Display Character Sheet
@expect "Defense Class"
@dump:sheet
ESC                     # leave the sheet, back to play mode
@dump:after
