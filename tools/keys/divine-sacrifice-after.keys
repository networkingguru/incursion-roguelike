# AFTER reproduction for inc-l8ws: Divine Sacrifice follows its source book,
# lasts 1 round per caster level, and its metamagic survives storage.
#
# Run from the repository root, with a fresh INCURSION_RUN_DIR under logs/:
#   INCURSION_OPTIONS=tools/fixtures/options-2026-08-22.dat \
#     INCURSION_RUN_DIR="$PWD/logs/inc-l8ws/after/seed-1" \
#     tools/headless.sh tools/keys/divine-sacrifice-after.keys 1
#
# ROUTE. tools/keys/divine-sacrifice-setup.keys builds a lawful good orc
# priest of Kysul (Good domain) at Priest 3, with Free Advancement, Infinite
# Mana and Freeze Monsters, and learns Divine Sacrifice. This script then
# advances the priest to Priest 5 (81 HP): since inc-nt3z the spell lasts
# (caster level + 1) / 2 status units (EF_DROUND, a unit is 60 ticks), and
# Priest 3 gets 1 unit, too short for the first attack, a rest and the cancel
# menu. Priest 5 gets 2 units.
#
# WHY SIX CASTINGS. Each attack costs 30 Timeout at this priest's speed and
# a round is 60 GetTurn() units (src/Fight.cpp:3501; src/Main.cpp:898,1311),
# so two back-to-back attacks with no rest fall in the same round: measured,
# the first pays and the second does not (lib/pspells.irh's once-per-round
# guard). The buff is gone within the four back-to-back attacks of a casting
# (the X menu drops "Drop Divine Sacrifice" and prints "You have nothing
# active to cancel."), and a casting pays at most about three times. That
# cannot drain 81 HP down to the 10 HP skip threshold, so the script casts six
# times, clearing the frozen target between castings with the wizard "Genocide
# Everything" (no adjacency at the moment of casting, so recasting cannot
# provoke the froghemoth's grab attack of opportunity, the same reason the
# very first cast happens before any target is summoned). Measured HP: 81
# -(pay)-> 71 (casting 1, cancelled here); 41 after casting 3; 21 after
# casting 4; 1 in casting 5, where the next payment would bring HP to 0 and is
# skipped; castings 5 and 6 pay nothing more.
#
# THE ORACLE IS THE SCREEN. Every @dump is a full screen: the five-choice
# menu ("[12345]"), the message log ("Damage: ... +N DSac ..." and
# "Attack: ... [hit]"/"[miss]"), the HUD line ("HP:x/y"), and the cancel
# menu ("[a] Drop Divine Sacrifice" or "You have nothing active to cancel.").
# Once HP is low the game raises a modal "Low Hitpoint Warning!" box that
# waits for a key, so every action from casting 2 onward is prefixed with
# ENTER to dismiss it if it is up; ENTER in map mode is otherwise harmless.
#
# Proved RED against four mutations on the fixed spell (see
# tools/check_divine_sacrifice.sh's header) and against the pre-fix
# lib/pspells.irh.
@include divine-sacrifice-setup.keys

# Two more Free Advancements, Priest 3 to Priest 5. Divine Sacrifice lasts
# (caster level + 1) / 2 status units since inc-nt3z (EF_DROUND; a unit is 60
# ticks). This cast is innate (Learn Any Spell), so the caster level is the
# priest's challenge rating. Measured: Priest 3 and 4 give 1 unit (the buff is
# gone 48 ticks after the cast, before the cancel menu check), Priest 5 gives
# 2 units. See the 'fact' lines in tools/check_divine_sacrifice.sh.
d
G
@while "Bonus To Which Attribute" a
@while "Choose a feat" a
@while "Choose a bonus" a
@while "Focus on which Weapon" a
@while "You feel" ESC
@while "more --" SPACE
G
@while "Bonus To Which Attribute" a
@while "Choose a feat" a
@while "Choose a bonus" a
@while "Focus on which Weapon" a
@while "You feel" ESC
@while "more --" SPACE
@dump:level5
ESC

# Cast Divine Sacrifice on the caster (self-target), before anything stands
# beside him. The menu must offer all five choices, and nothing is paid now.
# Pick the spell by moving the cursor, not by @choose: the Spell Manager lists
# two rows (domain divine + wizard primal), @choose refuses the ambiguous
# name, and either row casts the same spell for this check.
m
@until "Divine Sacrifice (" DOWN
ENTER
*
@dump:menu
5
@dump:cast

# --- Casting 1: pay+hit, a no-attack round pays nothing, the cancel menu
#     lists the buff while it is active, and dropping it ends the buff. ---
w
@choose "Monster Summoning"
@choose "Beasts"
@choose "froghemoth"
RIGHT ENTER
@dump:c1-summoned

RIGHT
@while "Confirm attack" y
@dump:c1-a1

ENTER
.
@dump:c1-rest

ENTER
x
@dump:c1-xmenu-active
ESC

ENTER
x
@choose "Drop Divine Sacrifice"
@dump:c1-cancelled
v
@dump:c1-cancel-messages
@expect "Dropping Divine Sacrifice."
ESC

# --- Casting 2: clear the target, recast, and drive two back-to-back
#     pay/skip attack pairs (the once-per-round guard). ---
ENTER
w
@choose "Genocide Everything"

ENTER
m
@until "Divine Sacrifice (" DOWN
ENTER
*
5

ENTER
w
@choose "Monster Summoning"
@choose "Beasts"
@choose "froghemoth"
RIGHT ENTER
@dump:c2-summoned

ENTER RIGHT
@while "Confirm attack" y
@dump:c2-a1
ENTER RIGHT
@dump:c2-a2
ENTER RIGHT
@dump:c2-a3
ENTER RIGHT
@dump:c2-a4

# --- Casting 3: clear, recast, keep draining -- HP falls to 8, below the
#     10 HP sacrifice, by the end of this casting. ---
ENTER
w
@choose "Genocide Everything"

ENTER
m
@until "Divine Sacrifice (" DOWN
ENTER
*
5

ENTER
w
@choose "Monster Summoning"
@choose "Beasts"
@choose "froghemoth"
RIGHT ENTER
@dump:c3-summoned

ENTER RIGHT
@while "Confirm attack" y
@dump:c3-a1
ENTER RIGHT
@dump:c3-a2
ENTER RIGHT
@dump:c3-a3
ENTER RIGHT
@dump:c3-a4

# --- Casting 4: clear, recast, keep draining. ---
ENTER
w
@choose "Genocide Everything"

ENTER
m
@until "Divine Sacrifice (" DOWN
ENTER
*
5

ENTER
w
@choose "Monster Summoning"
@choose "Beasts"
@choose "froghemoth"
RIGHT ENTER
@dump:c4-summoned

ENTER RIGHT
@while "Confirm attack" y
@dump:c4-a1
ENTER RIGHT
@dump:c4-a2
ENTER RIGHT
@dump:c4-a3
ENTER RIGHT
@dump:c4-a4

# --- Casting 5: clear, recast; HP falls to 1 and the sacrifice that would
#     bring it to 0 is skipped. ---
ENTER
w
@choose "Genocide Everything"

ENTER
m
@until "Divine Sacrifice (" DOWN
ENTER
*
5

ENTER
w
@choose "Monster Summoning"
@choose "Beasts"
@choose "froghemoth"
RIGHT ENTER
@dump:c5-summoned

ENTER RIGHT
@while "Confirm attack" y
@dump:c5-a1
ENTER RIGHT
@dump:c5-a2
ENTER RIGHT
@dump:c5-a3
ENTER RIGHT
@dump:c5-a4

# --- Casting 6: clear, recast at 1 HP -- every payment this casting must be skipped. ---
ENTER
w
@choose "Genocide Everything"

ENTER
m
@until "Divine Sacrifice (" DOWN
ENTER
*
5

ENTER
w
@choose "Monster Summoning"
@choose "Beasts"
@choose "froghemoth"
RIGHT ENTER
@dump:c6-summoned

ENTER RIGHT
@while "Confirm attack" y
@dump:c6-a1
ENTER RIGHT
@dump:c6-a2
ENTER RIGHT
@dump:c6-a3
ENTER RIGHT
@dump:c6-a4

# Rest four full rounds -- more than the 2-unit duration can survive, so
# this does not depend on how many of the four attacks above paid or on any
# per-seed shift in round alignment -- then confirm the buff is gone.
ENTER
.
ENTER
.
ENTER
.
ENTER
.
ENTER
x
@dump:c6-xmenu-expired

@quit
