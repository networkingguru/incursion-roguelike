# Generate depth-2..10 levels so the door-generation probe
# (INCURSION_DOORGEN_PROBE, src/DoorPickProbe.cpp) sees their random doors.
# Used by tools/check_door_lock_rate.sh with a loaded character
# (INCURSION_LOAD) and tools/fixtures/options-2026-08-22.dat. The wizard 'p'
# command jumps to depth 10 and builds every level between.
@until "Things in View" ESC

@dump:arrival
w y p "10" ENTER
s .*2
@dump:depth10
