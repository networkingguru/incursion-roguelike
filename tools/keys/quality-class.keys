# Key script for tools/check_quality_class.sh, INCURSION_QUALITY_CLASS_PROBE=1
# (src/QualityClassProbe.cpp, called once at the start of Game::Play; inc-rddai).
#
#   INCURSION_OPTIONS=tools/fixtures/options-2026-08-22.dat \
#   INCURSION_LOAD=tools/fixtures/chars/orc-barbarian-seed1-opt0822.sav \
#   INCURSION_QUALITY_CLASS_PROBE=1 \
#       tools/headless.sh tools/keys/quality-class.keys 1
#
# The probe asks for these answers, in this order, while it runs:
#   site 4, weapon  CraftItem (Augment): q "Add quality", a the one candidate
#                   (the light mace), the quality menu is dumped, ESC aborts
#   site 4, armor   the same four lines for the leather armour
#   site 5, x3      the Oil of Transformation "Select a New Form" menu, three
#                   times (plain, unnamed, eight): choose the long sword
# The dumps are specimens. The check reads logs/quality-class.log, never these.
# The final search is one real turn, so tools/headless.sh counts a session.
q
a
@dump:offer-weapon
ESC
q
a
@dump:offer-armor
ESC
@choose "long sword"
@choose "long sword"
@choose "long sword"
@dump:arrival

s
@dump:played
