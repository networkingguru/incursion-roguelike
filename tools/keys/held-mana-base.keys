# Baseline for tools/check_held_mana.sh: cast nothing, save, so the check
# reads the fixture's own spent and held mana.
# The fixture holds only the created character; setup-human-priest-mage-seed4-gate.keys makes the state the old save held (bd inc-10v7f).
@include setup-human-priest-mage-seed4-gate.keys
@dump:arrival
ESC
@expect "System Menu"
b
@dump:saved
