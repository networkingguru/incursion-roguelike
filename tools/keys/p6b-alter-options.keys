# inc-10v7f phase 6b: make a Human Warrior (point buy) after ALTERING the
# character generation options: the option screen is opened and one option is
# changed (the fifth in the list, maximum hit points), so the recorder writes
# the changed options file beside the .char (spec B11). Used by
# tools/compare_creation_walks.sh.

a       # Initial Choices: [a] Create a New Character
y       # Alter the character generation options? -- yes
DOWN*4  # to the fifth option
SPACE   # change it
ESC     # leave the option screen
y       # Your options will place the game in Explore Mode. Continue? -- yes

@choose "Human"
@choose "Athletics"
@choose "Diplomacy"
@choose "Warrior"
p       # Attributes: abort to Point Buy
RIGHT*6 DOWN RIGHT*8 DOWN RIGHT*10 DOWN RIGHT*10 DOWN RIGHT*4 DOWN RIGHT*8 DOWN RIGHT*9
ENTER   # every point spent
y       # Are these your final stats? -- yes
@choose "Neutral"
@choose "Alertness"
@choose "Dodge"
@choose "Athletic"
@choose "long sword"   # the Warrior's own focus pick
RIGHT*2 DOWN RIGHT*2 DOWN RIGHT*2 DOWN RIGHT*2 DOWN RIGHT*2 DOWN
ENTER y # Done, and confirm keeping the ranks
@while "wish to worship" y
@while "personality archetype" a
@until "Afoot" ESC

@dump:arrival
@until "System Menu" ESC
@expect "System Menu"
b       # [b] Save and Continue
@dump:saved
