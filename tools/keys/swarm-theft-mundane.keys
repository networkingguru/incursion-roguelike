# inc-67gh: frozen Warrior, cleared map, wizard-created (not SUMMONED) swarm.
# The fixture holds only the created character; setup-alignment-drain-warrior.keys makes the state the old save held (bd inc-10v7f).
@include setup-alignment-drain-warrior.keys
@until "System Menu" ESC
ESC
w
@while "Enter wizard mode" y
@choose "Genocide Everything"
w
@choose "Wizard Mode Switches"
DOWN*10
@dump:freeze-option
ESC
w
@choose "Monster Summoning"
@choose "Aberrations"
@choose "ethereal filcher"
RIGHT ENTER
@dump:swarm-created
.
@while "more --" SPACE
.
@while "more --" SPACE
.
@while "more --" SPACE
.
@while "more --" SPACE
.
@while "more --" SPACE
.
@while "more --" SPACE
.*20
@while "more --" SPACE
@dump:swarm-end
@quit
