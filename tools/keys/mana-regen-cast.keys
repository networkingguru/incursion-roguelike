RIGHT

@dump:after-casts

s                       # wait without resting: ~25 turns each (see header)
s
s
@dump:after-wait

ESC                     # System Menu -- and NOT a cancel; see the header
@expect "System Menu"
b                       # [b] Save and Continue
@dump:saved

# No @quit: it is Save and Quit and would write a second save this script
# did not ask for. Running out of keys ends the session with exactly the
# one save above.
