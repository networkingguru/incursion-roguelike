# Property 1, step 2: cast Shield, drop it from the Cancel Standing Ability
# menu (lowercase x; see concentration-core.keys), then save. Run:
# tools/check_held_mana.sh
# The fixture holds only the created character; setup-human-priest-mage-seed4-gate.keys makes the state the old save held (bd inc-10v7f).
@include setup-human-priest-mage-seed4-gate.keys
@until "Select Spell" m
@choose "Shield"
@while "more --" SPACE
@dump:cast
x
@dump:cancel-menu
@choose "Drop Shield"
@while "more --" SPACE
@dump:dropped
ESC
@expect "System Menu"
b
@dump:saved
