+#ifdef DESTROY_PROBE
+/* Temporary probe for the char-creation crash of 2026-08-21. Writes beside the
+   run's other logs so a headless session under logs/runs/<id>/ keeps its own
+   copy. Remove with the diagnosis. */
+#include <stdarg.h>
+void DestroyProbe(const char *fmt, ...) {
+    const char *path = getenv("DESTROY_PROBE_LOG");
+    FILE *fp = fopen(path ? path : "/tmp/destroyprobe.log", "at");
+    if (!fp)
+        return;
+    va_list ap;
+    va_start(ap, fmt);
+    vfprintf(fp, fmt, ap);
+    va_end(ap);
+    fputc('\n', fp);
+    fclose(fp);
+}
+#endif
