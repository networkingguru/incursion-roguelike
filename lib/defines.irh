#define COST_4     35
#define COST_4X    40
#define COST_5     45
#define COST_5X    50
#define COST_6     55
#define COST_6X    60

#define ABIL_BOOST_COST(percent) \
  ( (1000   * percent) / 200 ) \
  ( (4000   * percent) / 200 ) \
  ( (8000   * percent) / 200 ) \
  ( (16000  * percent) / 200 ) \
  ( (32000  * percent) / 200 ) \
  ( (64000  * percent) / 200 )
  
/* upstream: base-code defect, not a port artefact. It is wrong in shared
   script data and behaves the same on Win32, with the original typedefs and
   on the upstream compiler. The class description promises that each
   pseudonatural summoning "drains [Summoned Creature's CR x 2] mana, and this
   mana does not regenerate" (lib/prestige.irh:290-292), and the clause charged
   nothing at all. Tier Observed -- see bd inc-tek.22. Not sent to rmtew.

   THE LOOP IS DEFENSIVE AND CHANGES NOTHING TODAY, so do not read it as a
   second fix. The clause used to convert GetEncounterCreature(0) alone, while
   the Shadowdancer's parallel handler loops (lib/prestige.irh:2704-2705).
   Every encounter these spells summon carries NF_SINGLE -- "Summoned Monster"
   at lib/enclist.irh:114, "Holy Summons" at :33, "Nature's Ally" -- so exactly
   one creature arrives per cast and index 0 was already all of them. The loop
   is here so that a future multi-creature summon does not silently convert one
   of its creatures. It is Reasoned, not Observed.

   THE PRICE IS READ OFF THE CREATURE THE SPELL CALLED, before the template
   is added, because the template's own CR line is "CR: +4 (Min 7)"
   (lib/mon3.irh:1068). Charging afterwards would make every conversion cost
   at least 14 mana, so a 2-mana Monster Summoning I would carry a 14-mana
   drain and the ability would be unusable at the level it arrives. */
#define ALIENIST_CLAUSE(n)                      \
  On Event POST(EV_MAGIC_HIT) {                 \
    hObj cr; int16 i; int16 crCR;               \
    if (EActor->isCharacter())                  \
      if (EActor->LevelAs($"alienist") >= n+1)  \
        for (i=0; cr = EMap->GetEncounterCreature(i); i++) \
          if (cr->CanAddTemplate($"pseudonatural")) \
            {                                   \
              crCR = cr->ChallengeRating();     \
              cr->AddTemplate($"pseudonatural");\
              if (crCR > 0)                     \
                EActor->LoseMana(crCR * 2, true); \
            }                                   \
    return NOTHING;                             \
    };
    
#define ANIMATION_MORALITY(corpse, undead)                              \
  if (undead->isMType(MA_EVIL) && undead->HasMFlag(M_IALIGN))           \
    { EActor->Transgress($"mara",5,false,"creating inherently evil undead");  \
      EActor->AlignedAct(AL_NONGOOD|AL_EVIL,3,"creating inherently evil undead"); } \
  else if (undead->isMType(MA_EVIL) && !EActor->isMType(MA_EVIL) &&     \
            EActor->isCharacter() && isMarist)                          \
    undead->GainPermStati(ALIGNMENT,NULL,SS_MISC,AL_GOOD|AL_LAWFUL);    \
  if (corpse->HasStati(WAS_FRIENDLY,-1,EActor)) \
    EActor->Transgress($"Mara",5,false,"desecrating foes' bodies"); \
  if (!corpse->HasEffStati(CORPSE_FLAG,$"Mara"))\
    if (undead->isMType(MA_SAPIENT))            \
      EActor->gainFavour($"Mara",50);            \
  if (!isMarist)                                \
    EActor->AlignedAct(AL_NONGOOD|AL_EVIL,1,"creating undead with infernal power"); \
  EActor->Transgress($"Immotian",7,false,"creating undead");  \
  EActor->Transgress($"Hesani",7,false,"creating undead");    \
  EActor->Transgress($"Xavias",4,false,"creating undead");    \
  EActor->Transgress($"Erich",4,false,"creating undead");     \
  EActor->Transgress($"Ekliazeh",6,false,"creating undead");  \

#define ANIMATION_HEADER \
  bool isMarist; \
  isMarist = (EActor->getGod() == $"Mara" || \
    (EActor->isCharacter() && EActor->getGodLevel($"Mara") >= 2)); \


/* Imagine that for every pair of weapons we hold a best-out-of-21 pitfight
 * with equal fighters. The percentage of such matches won by a weapon is
 * its weimer-cost. This gives a feel for the relative powers of weapons.
 * Note that currently (Fri Dec 19 09:26:30 PST 2003) the enemy AI is 
 * really abysmal with reach weapons like the longspear. */
#define OPT_COST(wes,orig)     orig
    