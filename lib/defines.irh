#define SP_HARD         60
#define SP_VERY_HARD    30

#define IS_A_BUFF(the_cost) \
  Flags: EF_NOTBAD, EF_PERSISTANT, EF_LOSEMANA, EF_SHOWNAME, EF_CANCEL; \
  Base: SP_BUFF; Purpose: EP_BUFF; Cost: the_cost

