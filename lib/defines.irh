#define WEAPON_FOCUS_NATURAL_ATTACK \
  Stati[ADJUST_NAT,A_HIT_BRAWL,+1]

#define RACIAL_SKILL(sk,lv) \
  Stati[SKILL_BONUS,sk,lv]
