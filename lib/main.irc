Effect "XP Ticker" : EA_INFLICT
  {
    xval: TRAP_EVENT; yval: EV_TURN;
    Flags: EF_PERSISTANT; Base: 100; Cost: 1;
    On Event META(EV_TURN) {
      if ((1d10 == 1) && EActor->isCharacter())
        EActor->GainXP(1);
      return NOTHING;
      };
  }

/* APPEND-ONLY: THIS DECLARATION MUST STAY LAST, AND SO MUST ANY THAT FOLLOW
   IT. A resource's position in its array is part of the save format: a v1
   save records each array's length and each entry's name in position order,
   and the loader converts a saved reference by position (see
   docs/SAVE-SCHEMA-SPEC.md, "Resource references"). Adding a resource in the
   MIDDLE of an array therefore slides every later entry, and every save
   written before the addition then reads one resource too early.

   That is not hypothetical. This very resource was first declared in the
   middle of lib/m_items.irh by 4ba035b on 2026-08-24, which pushed 862
   Effects down one place. Measured on 2026-08-25 by reading both modules'
   own manifests: position 325 held "tongue of flame" before and
   "flame tongue immolation" after. A save from before that commit read its
   owner's Robe of Blending back as a Hat of Disguise. Moving the
   declaration here makes 4ba035b a legal append and the old saves correct.

   New resources go at the END of this file. Never in the middle of an
   existing list. */
/* The burn a flame tongue leaves on a corporeal undead. It is a separate
   resource because the flame tongue's EITEM(EV_HIT) hands its name to a
   TRAP_EVENT stati, and the dispatch calls the META handler of whatever
   resource that stati names. Three turns, 3d6 then 2d6 then 1d6, counted in
   the stati's own Val. Written for bd inc-tek.8.8, finding PA-08-F11; see the
   upstream: mark on that handler for why the sword needed one. */
0 Effect "flame tongue immolation" : EA_GENERIC
  { On Event META(EV_TURN) {
      hObj killer; int16 i;
      i = EActor->GetEffStatiVal(TRAP_EVENT,$"flame tongue immolation");
      if (i < 0 || i > 2)
        return NOTHING;
      EActor->SetEffStatiVal(TRAP_EVENT,$"flame tongue immolation",i+1);
      killer = EActor->GetEffStatiObj(TRAP_EVENT,$"flame tongue immolation");
      if (!GetHandle(killer))
        killer = EActor;
      ThrowDmg(EV_DAMAGE,AD_FIRE,(3-i)d6,"a flame tongue's fire",
               killer,EActor);
      DPrint(e,"Your withered flesh burns!",
               "The <EActor>'s withered flesh burns!");
      if (EActor->isDead() && killer != EActor)
        killer->KillXP(EActor);
      return NOTHING;
      },
    EV_ELAPSED
      "The flames on your flesh gutter out." /
      "The flames on the <EActor> gutter out.";
  }

/* APPEND-ONLY (see the note above the flame tongue immolation effect and
   docs/SAVE-SCHEMA-SPEC.md): new resources go HERE, at the end of parse order,
   never in the middle of an existing list. This is the throwable base item for
   the Dwarven Thrower artifact (lib/m_items.irh, finding PA-08-F46). Incursion's
   "throwing" is the IT_THROWABLE item flag, read from the item type, so the
   artifact needed a base warhammer that carries it; the .irh language has no item
   inheritance, so every stat below is a hand-copy of "warhammer" in
   lib/weapons.irh and MUST be kept in sync with it by hand. Only IT_THROWABLE (so
   it can be hurled) and IT_NOGEN (so it never drops as ordinary loot) differ. */
Item "warhammer;thrown" : T_WEAPON
  { Image: red GLYPH_WEAPON; Group: WG_IMPACT;
    Mat: MAT_IRON; Size: SZ_MEDIUM; Weight: 120;
    Cost: OPT_COST(40,14) GOLD; Parry: 3;
    SDmg: 1d8; LDmg: 1d8; Acc: 0; Crit: x3; Threat: 1; Spd: 80%;
    Flags: WT_BLUNT, WT_STR2, WT_STUNNING, WT_PENETRATING, IT_THROWABLE, IT_NOGEN;
    Desc: "The warhammer is a blunt weapon designed specifically to
      punch through plate armours. Its blows carry terrible force
      with them."; }

/* APPEND-ONLY (see the notes above and docs/SAVE-SCHEMA-SPEC.md): new
   resources go HERE, at the end of parse order, never in the middle of an
   existing list. This is the scarab swarm, rebuilt as a working swarm for
   bead inc-gapb. */
Monster "scarab swarm" : MA_SWARM, MA_VERMIN
{
  Image: black 'S'; Size: SZ_MINISCULE;
  CR: 7; HD: 12; Hit: +8; Def: 10; Mov: 175%; Spd: 100%;
  Str 1, Dex 14, Con 16, Int 1, Wis 13, Cha 8;
  Attk: A_CPRX for 3d6 AD_PIERCE,
        A_CPRX for 0d0 AD_DISE (DC 19),
        A_CPRX for 1d1 AD_SPE1;
	ABILITY(CA_WEAPON_IMMUNITY,1);
	ABILITY(CA_TREMORSENSE,12);
	RACIAL_SKILL(SK_CLIMB,8);
    /* upstream: FT_DASH had no FeatInfo row, so it printed "---N (below ...)---". Observed, inc-4trf, not sent. */
  Feats: FT_DASH, SK_CLIMB;
  Immune: DF_MIND;
  Flags: M_SWARM, M_NO_SIZE_HP, M_NO_CORPSE, M_CARNI, M_NOPOLY,
         M_AMORPH, M_HIDE_UNDER, M_NEUTER,
         M_NOHANDS, M_NOLIMBS, M_NOHEAD, M_HOSTILE;
  Disease: $"filth fever";
  On Event PRE(EV_DAMAGE) {
    if (e.DType == AD_SPE1) {
      if (!EVictim->isDead())
        if (!EVictim->SavingThrow(FORT,19,SA_CONF))
          EVictim->GainTempStati(NAUSEA,EVictim,1,SS_ENCH,0,0,
            $"scarab swarm");
      return DONE;
    }
    return NOTHING;
  } ,
  MSG_SPE1DESC "to nauseate (DC 19)";
  Desc: "A swarm of flesh-eating scarabs, given a hive-mind
    intellect by malevolent magic as the instrument of a dark
    god's wrath. The swarm cannot fly, but it is incredibly
    fast, flowing across corridors like a chitinous river and
    devouring everything in its path.";
}

