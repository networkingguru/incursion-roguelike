/* APPEND-ONLY: last Effect in parse order. inc-1qyv. The status lasts
   7200 stati units: one day, MENACE_DURATION in inc/Defines.h (the script compiler gives a syntax error on the name). */
AI_POTION Effect "True Blows" : EA_GENERIC
  { SC_THA; Level: 3; Flags: EF_AUTOID, EF_NOTBAD, EF_FIXED_PRICE;
    On Event MSG_STATINAME "True Blows" / "TrBl";
    On Event EV_MAGIC_HIT {
      EActor->GainTempStati(IGNORES_WEAPON_IMMUNITY,NULL,7200,
        SS_MISC,0,0,$"true blows");
      EActor->IPrint("Your hands tingle with a force that nothing can turn aside.");
      return DONE;
      };
    Desc: "When drunk, this potion lets the drinker's blows harm
      creatures that ordinary or weakly enchanted weapons cannot, and
      strike incorporeal creatures as a magic weapon does. The effect
      lasts one day. It works with any weapon and with bare hands, but
      gives no bonus to hit or to damage.";
  Lists:
    * ITEM_COST 50;
  }

/* APPEND-ONLY: last Effect in parse order. inc-2rws. The status lasts
   (20d4+1)/2 stati units: 20d4 rounds at 2 rounds per unit, rounded up
   (10 to 40 units). */
AI_POTION Effect "Water Walking;potion" : EA_GENERIC
  { SC_THA|SC_WATER; Level: 3; Flags: EF_AUTOID, EF_NOTBAD, EF_FIXED_PRICE;
    On Event MSG_STATINAME "WtrWlk" / "WW";
    On Event EV_MAGIC_HIT {
      EActor->GainTempStati(WATER_WALKING,NULL,(20d4+1)/2,
        SS_MISC,0,0,$"water walking;potion");
      return DONE;
      };
    Desc: "When drunk, this potion lets the drinker walk on the surface
      of deep and turbulent water, with no need to swim. The effect lasts
      20d4 rounds.";
  Lists:
    * ITEM_COST 50;
  }

/* APPEND-ONLY: last Effect in parse order. inc-gzkn. One duration roll, 20d4
   rounds, is shared by the four statuses; one status unit is 2 rounds, so the
   roll converts as (20d4+1)/2 units, 10 to 40. */
AI_POTION Effect "Elemental Resistance" : EA_GENERIC
  { SC_ABJ; Level: 3; Flags: EF_AUTOID, EF_NOTBAD, EF_FIXED_PRICE, EF_PROTECTS_ITEMS;
    On Event MSG_STATINAME "Elemental Resistance" / "ElRs";
    On Event EV_MAGIC_HIT {
      int16 dur;
      dur = (20d4+1)/2;
      EActor->GainTempStati(RESIST,NULL,dur,SS_MISC,AD_FIRE,10,$"elemental resistance");
      EActor->GainTempStati(RESIST,NULL,dur,SS_MISC,AD_COLD,10,$"elemental resistance");
      EActor->GainTempStati(RESIST,NULL,dur,SS_MISC,AD_ACID,10,$"elemental resistance");
      EActor->GainTempStati(RESIST,NULL,dur,SS_MISC,AD_ELEC,10,$"elemental resistance");
      return DONE;
      };
    Desc: "When drunk, this potion grants the drinker resistance 10 to
      fire, cold, acid and electricity. The effect lasts 20d4 rounds. The
      drinker's carried equipment is protected as well.";
  Lists:
    * ITEM_COST 50;
  }

/* APPEND-ONLY: last Effect in parse order, after Elemental Resistance. inc-w6t0. */
Wizard / Potion / Scroll Spell "Stone to Flesh" : EA_GENERIC
  { SC_THA; Base: SP_HARD; Cost: 20; Level: 6; qval: Q_TAR|Q_NEAR;
    Flags: EF_AFFECTS_ITEMS, EF_LIM_ITYPE; tval: T_STATUE;
    Purpose: EP_FIX_TROUBLE (TROUBLE_STONING);
    Desc: "Turns stone back into living flesh. Cast on a creature that
      is turning to stone, the spell stops the change and does no
      harm. Cast on a statue, it turns the statue into a living
      creature of the kind it shows. A statue that shows no kind
      becomes a creature found at the current depth.";
    On Event EV_MAGIC_HIT {
      rID mid; hObj mon; int16 sx, sy;
      if (ETarget->isType(T_STATUE)) {
        /* A statue becomes a NEW monster of its type; nothing from before
           the petrification is kept. A statue with no type gets one the way
           the level generator picks it. */
        mid = ETarget->GetCorpseType();
        if (!mid)
          mid = EMap->CorpseMonID();
        if (!mid)
          return DONE;
        sx = ETarget->x;
        sy = ETarget->y;
        ETarget->Remove(true);
        mon = EMap->BuildMonster(mid,sx,sy);
        /* System shock: a DC 15 Fortitude save, or the new body dies. */
        if (!mon->SavingThrow(FORT,15,SA_MAGIC))
          ThrowDmg(EV_DEATH,AD_NORM,0,"system shock",EActor,mon);
        return DONE;
        }
      /* RemoveStati prints "You feel more limber now." (src/Status.cpp:1306). */
      EVictim->RemoveStati(STONING);
      return DONE;
      };
  }
