#!/usr/bin/env sh
# --- BEGIN BEADS INTEGRATION v1.1.2 ---
# This section is managed by beads. Do not remove these markers.
if command -v bd >/dev/null 2>&1; then
  export BD_GIT_HOOK=1
  _bd_timeout=${BEADS_HOOK_TIMEOUT:-300}
  _bd_used_perl=0
  if command -v timeout >/dev/null 2>&1; then
    timeout "$_bd_timeout" bd hooks run pre-commit "$@"
    _bd_exit=$?
  elif command -v gtimeout >/dev/null 2>&1; then
    gtimeout "$_bd_timeout" bd hooks run pre-commit "$@"
    _bd_exit=$?
  elif command -v perl >/dev/null 2>&1; then
    _bd_used_perl=1
    perl -e 'alarm shift; exec @ARGV' "$_bd_timeout" bd hooks run pre-commit "$@"
    _bd_exit=$?
  else
    echo >&2 "beads: hook 'pre-commit' running without timeout; install coreutils or perl to enable BEADS_HOOK_TIMEOUT"
    bd hooks run pre-commit "$@"
    _bd_exit=$?
  fi
  if [ $_bd_exit -eq 124 ] || { [ $_bd_used_perl -eq 1 ] && [ $_bd_exit -eq 142 ]; }; then
    echo >&2 "beads: hook 'pre-commit' timed out after ${_bd_timeout}s — continuing without beads"
    _bd_exit=0
  fi
  if [ $_bd_exit -eq 3 ]; then
    echo >&2 "beads: database not initialized — skipping hook 'pre-commit'"
    _bd_exit=0
  fi
  if [ $_bd_exit -ne 0 ]; then exit $_bd_exit; fi
fi
# --- END BEADS INTEGRATION v1.1.2 ---

# --- INCURSION: a new bead must be fit to publish before it is committed ---
# (inc-m7xb, 2026-09-06)
#
# core.hooksPath points git at .beads/hooks, so this shim is the ONLY pre-commit
# hook git runs; a script in .git/hooks would never fire.
#
# WHY IT IS HERE AT ALL. tools/check_bead_publish.py was written on 2026-09-02,
# has a passing selftest, and was wired into NOTHING for four days while
# AGENTS.md, README.md and tools/sync_issues.sh all stated that it failed a
# commit. In that window inc-b12m reached the public tracker as GitHub issue
# #381 with an empty body. The rule existed; the hook did not.
#
# IT MUST BLOCK. This is the exact inverse of the pre-push shim next door, which
# must NEVER block a push: publication is a network operation whose failures have
# nothing to do with the commits, while an unfit bead is a defect in the commit
# itself. Brian's ruling on 2026-09-03: make it so you "physically CANNOT post a
# bead without desc, tags, etc." There is no bypass variable on purpose. The
# native git commit --no-verify flag remains, and using it is a deliberate act.
#
# EXIT 2 WARNS, IT DOES NOT BLOCK. Exit 2 means the script could not measure --
# no bd on PATH, no python3, an unreadable database. That is not a bead with a
# missing description, and failing every commit in a fresh clone would get the
# hook deleted within a week. Exit 1, a real unfit bead, blocks.
# --- INCURSION: work happens in a worktree, not in the shared checkout ---
# (inc-uw8s, 2026-09-11)
#
# Several agent sessions work in this repository at once. One directory has one
# HEAD, one index and one working tree, so a session that changes branch changes
# it for every session in that directory, silently and with no warning in
# anybody's status output.
#
# It failed twice in one hour on 2026-09-11. A session ran `git checkout -b
# inc-w26h-remaining` at 13:54:55; a second session, which had read "current
# branch: master" when it started and never touched HEAD, committed at 16:09 and
# landed on that branch. `git commit` takes no branch argument -- it advances
# whatever branch HEAD names. Master did not get the fix. Separately,
# tools/package_linux.sh exports the working tree, so that session's uncommitted
# src/Values.cpp and three lib/*.irh files compiled into published release
# assets (inc-iezk). The same class stranded b855fe2 on a review branch on
# 2026-09-04.
#
# The knowledge that a clean worktree is required already existed in a memory
# note and in a resume note on the day it happened, and it still happened. A
# rule an agent has to remember is a rule that breaks on a busy turn; a hook
# that refuses the command is not. That is the whole reason this is here and not
# in AGENTS.md alone.
#
# IT ONLY REFUSES THE SHARED CHECKOUT. A linked worktree has its own git dir, so
# --git-dir and --git-common-dir differ there and this block does not fire. The
# shared checkout stays the place where integration happens, so a MERGE commit
# is allowed: that is tools/finish_bead.sh landing work, not somebody starting
# new work in the wrong place.
if [ -z "${BD_GIT_HOOK_NESTED:-}" ]; then
  _inc_gitdir=$(git rev-parse --absolute-git-dir 2>/dev/null)
  _inc_common=$(cd "$(git rev-parse --git-common-dir 2>/dev/null)" 2>/dev/null && pwd)
  if [ -n "$_inc_gitdir" ] && [ "$_inc_gitdir" = "$_inc_common" ] \
     && [ ! -e "$_inc_gitdir/MERGE_HEAD" ]; then
    echo >&2 "pre-commit: REFUSED. This is the shared checkout, and new work does not"
    echo >&2 "happen here -- another session's branch change silently redirects your"
    echo >&2 "commit, and another session's uncommitted files land in your release."
    echo >&2 ""
    echo >&2 "Start the bead in a worktree of its own:"
    echo >&2 "    tools/worktree.sh <bead-id>"
    echo >&2 "then commit there. When it is done:"
    echo >&2 "    tools/finish_bead.sh <bead-id>"
    echo >&2 ""
    echo >&2 "A merge commit is allowed here, because integration IS this tree's job."
    echo >&2 "git commit --no-verify still works and remains a deliberate act."
    exit 1
  fi
fi

if [ -z "${BD_GIT_HOOK_NESTED:-}" ]; then
  _inc_root=$(git rev-parse --show-toplevel 2>/dev/null)
  if [ -x "$_inc_root/tools/check_bead_publish.py" ]; then
    BD_GIT_HOOK_NESTED=1 "$_inc_root/tools/check_bead_publish.py"
    _inc_pub=$?
    if [ $_inc_pub -eq 1 ]; then
      echo >&2 "pre-commit: a bead created since the last commit is not fit to publish. Fix it above, or use git commit --no-verify and answer for it."
      exit 1
    fi
    if [ $_inc_pub -ne 0 ]; then
      echo >&2 "pre-commit: check_bead_publish.py could not measure (exit $_inc_pub); the commit CONTINUES."
    fi
  fi
fi
